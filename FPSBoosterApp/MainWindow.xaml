<Window x:Class="FPSBoosterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Booster"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MinWidth="880"
        MinHeight="560"
        Width="960" Height="680"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="BoostField" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="BoostLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ==================== Window Frame ==================== -->
        <Border x:Name="WindowFrame" CornerRadius="16" Margin="14" Background="{DynamicResource BgBrush}"
                BorderBrush="{StaticResource WindowEdgeBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- ==================== Title Bar ==================== -->
                <Border Grid.Row="0" Background="{DynamicResource BgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="7" Margin="14,0,9,0"
                                    Background="{StaticResource AccentGradientBrush}">
                                <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconZap}"
                                      Width="12" Height="12" Stroke="{StaticResource OnAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="FPS Booster" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="AdminBadge" Background="{StaticResource OnlineBrush}"
                                    CornerRadius="4" Padding="5,2" Margin="10,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="ADMIN" FontSize="8.5" FontWeight="Bold" Foreground="#06120B"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowControlButton}" Width="44" Height="44"
                                    ToolTip="Minimize" Click="Minimize_Click">
                                <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconMinimize}"
                                      Width="12" Height="12" Stroke="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource WindowCloseButton}" Width="44" Height="44"
                                    ToolTip="Close" Click="Close_Click">
                                <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconClose}"
                                      Width="12" Height="12" Stroke="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== Content ==================== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="262"/>
                    </Grid.ColumnDefinitions>

                    <!-- ==================== Main: hero + tweaks ==================== -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,14,16,14">

                            <!-- Hero -->
                            <Border Background="{StaticResource AccentGradientBrush}"
                                    BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="20,18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.4" Color="#EF4444"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Boost your FPS" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="One click applies the recommended tweaks below. Every change can be restored."
                                                   FontSize="12" Foreground="#FFF0F0F0" Margin="0,3,0,0"
                                                   TextWrapping="Wrap" MaxWidth="430"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BoostButton" Content="BOOST NOW"
                                            Style="{StaticResource ModernButton}" Height="42" Padding="22,0"
                                            VerticalAlignment="Center" Click="Boost_Click"
                                            AutomationProperties.Name="Boost now"/>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                                <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconZap}"
                                      Width="13" Height="13" Stroke="{StaticResource AccentTextBrush}"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="TWEAKS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel x:Name="TweakList"/>

                            <!-- Game exe input (for the GPU tweak) -->
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="GAME EXE PATH" Style="{StaticResource BoostLabel}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="GameExeBox" Style="{StaticResource BoostField}"
                                             AutomationProperties.Name="Game exe path"
                                             ToolTip="e.g. C:\Games\game.exe - used by the high-performance GPU tweak"
                                             TextChanged="GameExe_Changed"/>
                                    <TextBlock Text="Optional - only needed if you enable the high-performance GPU tweak above."
                                               FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Background="{DynamicResource BgBrush}"/>

                    <!-- ==================== Sidebar ==================== -->
                    <Border Grid.Column="2" Background="{DynamicResource BgElevatedBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,14,14,14">
                                <TextBlock Text="STATUS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="12,12">
                                    <StackPanel>
                                        <TextBlock x:Name="AppliedCountText" Text="0 of 6 applied" FontSize="21"
                                                   FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="tweaks currently active" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <Border Height="1" Background="{StaticResource DividerBrush}"
                                                Margin="0,10,0,10"/>
                                        <TextBlock x:Name="StatusText" Text="Ready" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="RestoreButton" Content="Restore defaults"
                                        Style="{StaticResource OutlineButton}" Height="34" Margin="0,12,0,0"
                                        AutomationProperties.Name="Restore defaults" Click="Restore_Click"/>

                                <Button x:Name="AdminButton" Style="{StaticResource GhostButton}" Height="34"
                                        Margin="0,8,0,0" Click="RestartAsAdmin_Click"
                                        AutomationProperties.Name="Restart as administrator"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconShield}"
                                              Width="12" Height="12" Stroke="{StaticResource AccentTextBrush}"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Restart as administrator" FontSize="11.5"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,10"/>

                                <TextBlock x:Name="AdminHint"
                                           Text="The power plan and Nagle tweaks need administrator rights. Press the button above to relaunch with them - Windows will ask for permission once."
                                           FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="This app changes Windows settings in the registry. Everything it applies can be restored with 'Restore defaults'."
                                           FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ==================== Status Bar ==================== -->
                <Border Grid.Row="2" Background="{DynamicResource BgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6"
                                     Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusBarText" Text="Ready" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="AdminStatusText" Grid.Column="2" FontSize="10.5"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
