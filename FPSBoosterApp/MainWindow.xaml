<Window x:Class="FPSBoosterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CFG2 Recorder"
        Width="1040" Height="700" MinWidth="900" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#000000"
        AllowsTransparency="False"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SegContainer" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="3"/>
        </Style>

        <Style x:Key="SegToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceActiveBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallField" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource WindowEdgeBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- === Title bar === -->
            <Border Grid.Row="0" Background="#050505" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                <Grid Height="46">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Image Source="Assets/logo.png" Width="24" Height="24" Stretch="Uniform"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CFG2 RECORDER" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="VersionText" Text="v1.1.0" FontSize="9.5"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource SurfaceAltBrush}" CornerRadius="20"
                            Padding="12,4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HeaderDot" Width="8" Height="8" Fill="{StaticResource TextTertiaryBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeaderStatusText" Margin="8,0,0,0" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Text="Ready"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button x:Name="MinBtn" Style="{StaticResource WindowControlButton}" Click="Minimize_Click">
                            <Path Data="{StaticResource IconMinimize}" Style="{StaticResource StrokeIcon}"
                                  Width="13" Height="13"/>
                        </Button>
                        <Button x:Name="MaxBtn" Style="{StaticResource WindowControlButton}" Click="Maximize_Click">
                            <Path x:Name="MaxIcon" Data="{StaticResource IconMaximize}" Style="{StaticResource StrokeIcon}"
                                  Width="13" Height="13"/>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource WindowCloseButton}" Click="Close_Click">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource StrokeIcon}"
                                  Width="13" Height="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- === Content === -->
            <Grid Grid.Row="1" Margin="18,18,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column: sources / audio / output / settings -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SOURCE" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource SegContainer}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="SrcMonitorBtn" Grid.Column="0"
                                                      Style="{StaticResource SegToggle}" IsChecked="True"
                                                      Content="Monitor" Checked="SrcMode_Changed"/>
                                        <ToggleButton x:Name="SrcWindowBtn" Grid.Column="1"
                                                      Style="{StaticResource SegToggle}"
                                                      Content="Window" Checked="SrcMode_Changed"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="MonitorPanel">
                                    <TextBlock Text="DISPLAY" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="MonitorCombo" Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="MonitorCombo_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel x:Name="WindowPanel" Visibility="Collapsed">
                                    <TextBlock Text="WINDOW" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="WindowCombo" Style="{StaticResource ModernComboBox}"/>
                                        <Button Grid.Column="1" x:Name="RefreshWindowsBtn" Margin="8,0,0,0"
                                                Style="{StaticResource GhostButton}" Click="RefreshWindows_Click"
                                                ToolTip="Refresh window list">
                                            <Path Data="{StaticResource IconRefresh}" Style="{StaticResource StrokeIcon}"
                                                  Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="AUDIO" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="SystemAudioCheck" Content="System sound (what you hear)"
                                          IsChecked="True" Margin="0,0,0,10"/>
                                <CheckBox x:Name="MicCheck" Content="Microphone" IsChecked="False"
                                          Checked="MicCheck_Changed" Unchecked="MicCheck_Changed" Margin="0,0,0,10"/>
                                <ComboBox x:Name="MicCombo" Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False" Margin="14,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="OUTPUT" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                                <TextBlock Text="FOLDER" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FolderBox" Style="{StaticResource FieldTextBox}"
                                             Height="34" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="BrowseBtn" Content="Browse…" Margin="8,0,0,0"
                                            Style="{StaticResource OutlineButton}" Click="Browse_Click"/>
                                </Grid>
                                <TextBlock Text="FRAME RATE" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <ComboBox x:Name="FpsCombo" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="30 FPS" IsSelected="True"/>
                                    <ComboBoxItem Content="60 FPS"/>
                                </ComboBox>
                                <TextBlock x:Name="FpsLockHint" Text="60 FPS requires Premium" FontSize="10.5"
                                           Foreground="{StaticResource TextTertiaryBrush}" Margin="2,6,0,0"
                                           Visibility="Collapsed"/>

                                <TextBlock Text="CROP" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>
                                <CheckBox x:Name="CropCheck" Content="Crop (drag the box on the preview)"
                                          IsChecked="False" Checked="CropCheck_Changed" Unchecked="CropCheck_Changed"/>
                                <Grid Margin="14,10,0,0" IsEnabled="{Binding ElementName=CropCheck, Path=IsChecked}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="CropXBox" Style="{StaticResource SmallField}" Text="0"
                                             TextChanged="CropField_Changed" ToolTip="X"/>
                                    <TextBox Grid.Column="2" x:Name="CropYBox" Style="{StaticResource SmallField}" Text="0"
                                             TextChanged="CropField_Changed" ToolTip="Y"/>
                                    <TextBox Grid.Column="4" x:Name="CropWBox" Style="{StaticResource SmallField}"
                                             TextChanged="CropField_Changed" ToolTip="Width"/>
                                    <TextBox Grid.Column="6" x:Name="CropHBox" Style="{StaticResource SmallField}"
                                             TextChanged="CropField_Changed" ToolTip="Height"/>
                                </Grid>
                                <Button x:Name="CropResetBtn" Content="Reset crop" Margin="14,8,0,0"
                                        HorizontalAlignment="Left" Style="{StaticResource OutlineButton}"
                                        Padding="10,5" FontSize="11" Click="CropReset_Click"
                                        IsEnabled="{Binding ElementName=CropCheck, Path=IsChecked}"/>

                                <TextBlock x:Name="FileNamePreview" FontSize="11"
                                           Foreground="{StaticResource TextTertiaryBrush}" Margin="0,12,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SETTINGS" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                                <TextBlock Text="ENCODER" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="EncoderCombo" Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="EncoderCombo_Changed"/>
                                <TextBlock x:Name="EncoderHint" Text="Hardware encoding keeps recordings smooth at 60 FPS."
                                           FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="2,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="QUALITY" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <ComboBox x:Name="QualityCombo" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="Low (smaller file)"/>
                                    <ComboBoxItem Content="Medium" IsSelected="True"/>
                                    <ComboBoxItem Content="High"/>
                                    <ComboBoxItem Content="Ultra (big file)"/>
                                </ComboBox>
                                <TextBlock Text="OUTPUT RESOLUTION" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <ComboBox x:Name="ResCombo" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="Source size" IsSelected="True"/>
                                    <ComboBoxItem Content="1920 × 1080"/>
                                    <ComboBoxItem Content="1280 × 720"/>
                                    <ComboBoxItem Content="854 × 480"/>
                                </ComboBox>
                                <CheckBox x:Name="FitCheck" Content="Fit to frame (keep aspect)" IsChecked="True"
                                          Margin="0,10,0,0"/>
                                <TextBlock Text="FORMAT" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <ComboBox x:Name="FormatCombo" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="MP4 (best for sharing)" IsSelected="True"/>
                                    <ComboBoxItem Content="MKV (best for editing)"/>
                                </ComboBox>
                                <TextBlock Text="RECORD HOTKEY" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <ComboBox x:Name="HotkeyCombo" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="F9" IsSelected="True"/>
                                    <ComboBoxItem Content="F8"/>
                                    <ComboBoxItem Content="F7"/>
                                    <ComboBoxItem Content="Off"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right column: preview + controls + premium -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- preview -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0" ClipToBounds="True">
                        <Grid>
                            <Grid.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#0A0A0C">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,24,24"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#121215">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,12,12"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#121215">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="12,12,12,12"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.Background>
                            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"
                                   SizeChanged="PreviewArea_SizeChanged"/>
                            <Canvas x:Name="CropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                                <Rectangle x:Name="DimTop" Fill="#99000000"/>
                                <Rectangle x:Name="DimBottom" Fill="#99000000"/>
                                <Rectangle x:Name="DimLeft" Fill="#99000000"/>
                                <Rectangle x:Name="DimRight" Fill="#99000000"/>
                                <Rectangle x:Name="CropBorder" Stroke="{StaticResource AccentBrush}"
                                           StrokeThickness="1.5" StrokeDashArray="4 3"/>
                            </Canvas>
                            <Border x:Name="PreviewPlaceholder" Background="#66000000" CornerRadius="8">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewHintText"
                                               Text="Select a display and the preview appears here"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                                               MaxWidth="260" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="RecBadge" Background="#CC000000" CornerRadius="14" Padding="10,5"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="RecDot" Width="9" Height="9" Fill="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RecTimeText" Text="00:00:00" FontSize="11.5" FontWeight="Bold"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextBrush}" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- controls + stats -->
                    <Grid Grid.Row="1" Margin="0,14,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="ResText" Text="—" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="FpsText" Text="0 FPS" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="RecBtn" Click="RecBtn_Click" Width="230" Height="54"
                                Cursor="Hand" Focusable="False" HorizontalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{StaticResource AccentGradientBrush}"
                                            CornerRadius="27">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.6" Color="#99EF4444"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse x:Name="RecIcon" Width="13" Height="13" Fill="White"
                                                     Margin="0,0,11,0"/>
                                            <TextBlock x:Name="RecLabel" Text="START RECORDING" FontSize="14"
                                                       FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentGradientHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentGradientPressedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="SizeText" Text="0 MB" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="StatusDetail" Text="F9 to start / stop" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- premium -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PREMIUM" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                                    <Border x:Name="PremiumBadge" Background="#1A57F287" CornerRadius="10"
                                            Padding="10,2" Margin="10,0,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="PremiumBadgeText" Text="ACTIVE" FontSize="9.5"
                                                   FontWeight="Bold" Foreground="{StaticResource OnlineBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="PremiumHint" Text="Unlock 60 FPS and watermark-free recordings with a license key."
                                           FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,8,0,10" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="KeyBox" Style="{StaticResource FieldTextBox}" Height="36"
                                             VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                             FontSize="12"/>
                                    <Button Grid.Column="1" x:Name="ActivateBtn" Content="Activate" Margin="8,0,0,0"
                                            Style="{StaticResource ModernButton}" Click="Activate_Click"/>
                                </Grid>
                                <TextBlock x:Name="KeyStatusText" FontSize="11" Margin="2,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10"
                                    Padding="10" VerticalAlignment="Top" Margin="14,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="PREMIUM EXTRAS" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                    <TextBlock Text="• 60 FPS capture" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="• No watermark" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,3,0,0"/>
                                    <TextBlock Text="• Best quality (CRF 18)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
