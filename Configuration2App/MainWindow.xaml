<Window x:Class="Configuration2App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Discord Embed Sender"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MinWidth="1024"
        MinHeight="660"
        Width="1200" Height="780"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Composer inputs: app-level dark field style, sized for the form. -->
        <Style x:Key="ComposerField" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>

        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" Background="{TemplateBinding Background}"
                                CornerRadius="13" BorderThickness="2">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#00FFFFFF"/>
                            </Border.BorderBrush>
                            <Path x:Name="Check" Data="{StaticResource IconCheck}" Stretch="Uniform"
                                  Width="10" Height="10" Stroke="{StaticResource OnAccentBrush}"
                                  StrokeThickness="2.4" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush"
                                        Value="{StaticResource TextTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmbedTabButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FieldRowTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ComposerField}" ToolTip="Field name"/>
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ComposerField}" Margin="6,0,0,0" ToolTip="Field value"/>
                <CheckBox Grid.Column="2" IsChecked="{Binding IsInline}"
                          ToolTip="Inline — side by side with the next inline field"
                          Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Width="26" Height="26"
                        Margin="4,0,0,0" ToolTip="Remove field" Click="RemoveField_Click">
                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconClose}"
                          Width="10" Height="10" Stroke="{StaticResource TextSecondaryBrush}"/>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ==================== Window Frame ==================== -->
        <Border x:Name="WindowFrame" CornerRadius="16" Margin="14" Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <!-- ==================== Title Bar ==================== -->
                <Border Grid.Row="0" Background="{DynamicResource BgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="7" Margin="14,0,9,0"
                                    Background="{DynamicResource AccentGradientBrush}">
                                <Grid>
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconSend}"
                                          Width="11" Height="11" Stroke="{StaticResource OnAccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="TitleLogo" Stretch="Uniform"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Discord Embed Sender" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowControlButton}" Width="44" Height="44"
                                    ToolTip="Settings" AutomationProperties.Name="Settings"
                                    Click="SettingsButton_Click">
                                <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconSettings}"
                                      Width="13" Height="13" Stroke="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource WindowControlButton}" Width="44" Height="44"
                                    ToolTip="Minimize" Click="Minimize_Click">
                                <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconMinimize}"
                                      Width="12" Height="12" Stroke="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource WindowControlButton}" Width="44" Height="44"
                                    ToolTip="Maximize" Click="Maximize_Click">
                                <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconMaximize}"
                                      Width="12" Height="12" Stroke="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource WindowCloseButton}" Width="44" Height="44"
                                    ToolTip="Close" Click="Close_Click">
                                <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconClose}"
                                      Width="12" Height="12" Stroke="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== Content ==================== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="248"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="432"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ==================== Sidebar: connection ==================== -->
                    <Border Grid.Column="0" Background="{DynamicResource BgElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,12,14,14">

                                <!-- Webhook connection card -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="12,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconGlobe}"
                                                  Width="13" Height="13" Stroke="{DynamicResource AccentTextBrush}"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="WEBHOOK" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Ellipse x:Name="WebhookDot" Width="8" Height="8"
                                                     Fill="{StaticResource TextDisabledBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="TARGET" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextTertiaryBrush}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBox x:Name="WebhookUrlBox" Style="{StaticResource ComposerField}"
                                                 Height="40" Margin="0,6,0,0" VerticalContentAlignment="Center"
                                                 TextWrapping="Wrap"
                                                 ToolTip="Server Settings → Integrations → Webhooks — copy the webhook URL"
                                                 TextChanged="WebhookUrl_Changed"/>
                                        <Button x:Name="TestWebhookButton" Content="Test webhook"
                                                Style="{StaticResource OutlineButton}" Height="32" Margin="0,8,0,0"
                                                Click="TestWebhook_Click" IsEnabled="False"/>
                                        <TextBlock x:Name="WebhookStatusText" Text="No webhook set"
                                                   FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconUser}"
                                          Width="13" Height="13" Stroke="{DynamicResource AccentTextBrush}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="SEND AS" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="NAME"/>
                                <TextBox x:Name="UsernameBox" Style="{StaticResource ComposerField}"
                                         ToolTip="Display name for this message (overrides the webhook's name)"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="AVATAR URL"/>
                                <TextBox x:Name="AvatarBox" Style="{StaticResource ComposerField}"
                                         ToolTip="Avatar image URL for this message (overrides the webhook's avatar)"/>
                                <CheckBox x:Name="TtsCheck" Content="Text-to-speech"
                                          Margin="0,10,0,0" ToolTip="Send as text-to-speech"/>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,10"/>
                                <TextBlock Text="The preview updates as you type. One message can hold up to 10 embeds and 6,000 characters total."
                                           FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource BgBrush}"/>

                    <!-- ==================== Composer ==================== -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Margin="12" Padding="16,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                        <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconPencil}"
                                              Width="13" Height="13" Stroke="{DynamicResource AccentTextBrush}"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="COMPOSER" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Clear" Style="{StaticResource GhostButton}"
                                            Height="28" Padding="12,0" Margin="0,0,0,6"
                                            VerticalAlignment="Center" Click="Clear_Click"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconBraces}"
                                          Width="13" Height="13" Stroke="{DynamicResource AccentTextBrush}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="MESSAGE" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="ContentBox" Style="{StaticResource ComposerField}" Height="34"
                                         TextChanged="Composer_Changed"
                                         ToolTip="Plain message sent above the embeds (optional)"/>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <StackPanel x:Name="EmbedTabs" Orientation="Horizontal"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconLayers}"
                                          Width="13" Height="13" Stroke="{DynamicResource AccentTextBrush}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="EMBED" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,4"/>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="TITLE"/>
                                        <TextBox x:Name="EmbedTitleBox" Style="{StaticResource ComposerField}" TextChanged="Composer_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,3">
                                            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconLink}"
                                                  Width="11" Height="11" Stroke="{StaticResource TextTertiaryBrush}"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="LINK" Style="{StaticResource FieldLabel}" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <TextBox x:Name="EmbedUrlBox" Style="{StaticResource ComposerField}" TextChanged="Composer_Changed"
                                                 ToolTip="Makes the title a link"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="DESCRIPTION"/>
                                <TextBox x:Name="EmbedDescBox" Style="{StaticResource ComposerField}" Height="72"
                                         TextWrapping="Wrap" AcceptsReturn="True" TextChanged="Composer_Changed"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconSparkles}"
                                          Width="13" Height="13" Stroke="{DynamicResource AccentTextBrush}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="COLOR" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,4"/>
                                <StackPanel x:Name="SwatchRow" Orientation="Horizontal">
                                    <Button Style="{StaticResource SwatchButton}" Background="#5865F2" Tag="5865F2" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#ED4245" Tag="ED4245" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#57F287" Tag="57F287" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#FEE75C" Tag="FEE75C" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#EB459E" Tag="EB459E" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#00A8FC" Tag="00A8FC" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#F57C00" Tag="F57C00" Click="Swatch_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Background="#FFFFFF" Tag="FFFFFF" Click="Swatch_Click"/>
                                    <TextBox x:Name="ColorHexBox" Style="{StaticResource ComposerField}" Width="82"
                                             Text="5865F2" MaxLength="7" TextChanged="ColorHex_Changed"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconUser}"
                                          Width="13" Height="13" Stroke="{DynamicResource AccentTextBrush}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="AUTHOR" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="NAME"/>
                                        <TextBox x:Name="AuthorNameBox" Style="{StaticResource ComposerField}" TextChanged="Composer_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,3">
                                            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconLink}"
                                                  Width="11" Height="11" Stroke="{StaticResource TextTertiaryBrush}"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="URL" Style="{StaticResource FieldLabel}" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <TextBox x:Name="AuthorUrlBox" Style="{StaticResource ComposerField}" TextChanged="Composer_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ICON URL"/>
                                <TextBox x:Name="AuthorIconBox" Style="{StaticResource ComposerField}" TextChanged="Composer_Changed"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconCloud}"
                                          Width="13" Height="13" Stroke="{DynamicResource AccentTextBrush}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="MEDIA" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="THUMBNAIL URL"/>
                                        <TextBox x:Name="ThumbUrlBox" Style="{StaticResource ComposerField}" TextChanged="Composer_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="IMAGE URL"/>
                                        <TextBox x:Name="ImageUrlBox" Style="{StaticResource ComposerField}" TextChanged="Composer_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconInfo}"
                                          Width="13" Height="13" Stroke="{DynamicResource AccentTextBrush}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="FOOTER" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="TEXT"/>
                                        <TextBox x:Name="FooterTextBox" Style="{StaticResource ComposerField}" TextChanged="Composer_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,3">
                                            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconLink}"
                                                  Width="11" Height="11" Stroke="{StaticResource TextTertiaryBrush}"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="ICON URL" Style="{StaticResource FieldLabel}" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <TextBox x:Name="FooterIconBox" Style="{StaticResource ComposerField}" TextChanged="Composer_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="TimestampCheck" Content="Include timestamp"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          FontSize="11" Margin="0,12,0,0" IsChecked="True"
                                          Checked="TimestampCheck_Changed" Unchecked="TimestampCheck_Changed"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconList}"
                                          Width="13" Height="13" Stroke="{DynamicResource AccentTextBrush}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="FIELDS" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,4"/>
                                <ItemsControl x:Name="FieldsList" ItemTemplate="{StaticResource FieldRowTemplate}"/>
                                <Button Style="{StaticResource GhostButton}" Height="30" Margin="0,4,0,0"
                                        HorizontalAlignment="Left" Padding="12,0" Click="AddField_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconPlus}"
                                              Width="12" Height="12" Stroke="{DynamicResource AccentTextBrush}"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Add field" FontSize="11.5" Margin="6,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <Border Grid.Column="3" Background="{DynamicResource BgBrush}"/>

                    <!-- ==================== Preview ==================== -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource BgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconEye}"
                                              Width="14" Height="14" Stroke="{StaticResource TextTertiaryBrush}"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="PREVIEW" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="7,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource OnlineBrush}" CornerRadius="3" Padding="4,1"
                                                Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="LIVE" FontSize="8.5" FontWeight="Bold" Foreground="#06120B"/>
                                        </Border>
                                    </StackPanel>
                                <Button Grid.Column="1" x:Name="SendButton"
                                        Style="{StaticResource ModernButton}" Height="34" Padding="18,0"
                                        Click="Send_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconSend}"
                                              Width="13" Height="13" Stroke="{StaticResource OnAccentBrush}"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Send Embed" FontSize="12" FontWeight="SemiBold"
                                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Margin="12" Padding="18,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>

                                    <!-- Fake Discord message chrome so the preview reads like the real thing -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="38" Height="38" CornerRadius="19"
                                                Background="{DynamicResource AccentGradientBrush}">
                                            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconSend}"
                                                  Width="17" Height="17" Stroke="{StaticResource OnAccentBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="PreviewSender" Text="Webhook" FontSize="14"
                                                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Border Background="{DynamicResource AccentGradientBrush}" CornerRadius="4" Padding="4,1"
                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="BOT" FontSize="9" FontWeight="Bold"
                                                               Foreground="#FFFFFF"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="PreviewTime" Text="Today at 3:42 PM" FontSize="11.5"
                                                       Foreground="#949BA4" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="PreviewStack"/>

                                    <Border x:Name="PreviewEmpty" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="18,24" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconEye}"
                                                  Width="22" Height="22" Stroke="{StaticResource TextTertiaryBrush}"
                                                  HorizontalAlignment="Center"/>
                                            <TextBlock Text="Nothing to preview yet" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                            <TextBlock Text="Type a title or description and watch your embed build here."
                                                       FontSize="11.5" Foreground="{StaticResource TextTertiaryBrush}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ==================== Status Bar ==================== -->
                <Border Grid.Row="2" Background="{DynamicResource BgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6"
                                     Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Ready" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="CharCountText" Grid.Column="2" Text="" FontSize="10.5"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== Settings Overlay ==================== -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Panel.ZIndex="30">
            <Border Background="{StaticResource ScrimBrush}" CornerRadius="16" Margin="14"/>
            <Border Width="400" Background="{DynamicResource BgElevatedBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="14" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconSettings}"
                                  Width="15" Height="15" Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="SETTINGS" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Width="28" Height="28"
                                ToolTip="Close" AutomationProperties.Name="Close settings" Click="CloseSettings_Click">
                            <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconClose}"
                                  Width="11" Height="11" Stroke="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="ACCENT THEME" Margin="0,18,0,6"/>
                    <StackPanel x:Name="ThemeRow" Orientation="Horizontal">
                        <Button Style="{StaticResource SwatchButton}" Background="#6366F1" Tag="indigo" AutomationProperties.Name="Theme indigo" Click="ThemeSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#8B5CF6" Tag="violet" AutomationProperties.Name="Theme violet" Click="ThemeSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#10B981" Tag="green" AutomationProperties.Name="Theme green" Click="ThemeSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#EF4444" Tag="red" AutomationProperties.Name="Theme red" Click="ThemeSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#F97316" Tag="orange" AutomationProperties.Name="Theme orange" Click="ThemeSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#06B6D4" Tag="cyan" AutomationProperties.Name="Theme cyan" Click="ThemeSwatch_Click"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#EC4899" Tag="pink" AutomationProperties.Name="Theme pink" Click="ThemeSwatch_Click"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="FONT" Margin="0,18,0,6"/>
                    <ComboBox x:Name="FontCombo" Style="{StaticResource ModernComboBox}"
                              AutomationProperties.Name="Font"
                              SelectionChanged="FontCombo_SelectionChanged"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="FONT SIZE" Margin="0,18,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SizeSButton" Content="S" Tag="S" Style="{StaticResource OutlineButton}"
                                Width="46" Height="30" Margin="0,0,8,0" Click="SizePreset_Click"
                                AutomationProperties.Name="Font size S"/>
                        <Button x:Name="SizeMButton" Content="M" Tag="M" Style="{StaticResource OutlineButton}"
                                Width="46" Height="30" Margin="0,0,8,0" Click="SizePreset_Click"
                                AutomationProperties.Name="Font size M"/>
                        <Button x:Name="SizeLButton" Content="L" Tag="L" Style="{StaticResource OutlineButton}"
                                Width="46" Height="30" Click="SizePreset_Click"
                                AutomationProperties.Name="Font size L"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconRefresh}"
                              Width="13" Height="13" Stroke="{DynamicResource AccentTextBrush}"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="UPDATES" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="CURRENT VERSION" Margin="0,0,0,2"/>
                    <TextBlock x:Name="VersionText" Text="1.0.0" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               AutomationProperties.AutomationId="VersionText"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="GITHUB REPO  (owner/repo)"/>
                    <TextBox x:Name="GitHubRepoBox" Style="{StaticResource ComposerField}"
                             AutomationProperties.Name="Update repo"
                             ToolTip="Your GitHub repo, e.g. essam/cfg2-apps — the latest release must have a vX.Y.Z tag and the exe as its asset"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="OR UPDATE URL  (version.json)"/>
                    <TextBox x:Name="UpdateUrlBox" Style="{StaticResource ComposerField}"
                             AutomationProperties.Name="Update URL"
                             ToolTip="URL of a JSON file: { &quot;version&quot;: &quot;1.2.0&quot;, &quot;url&quot;: &quot;https://host/app.exe&quot; }"/>

                    <CheckBox x:Name="UpdateOnStartupCheck" Content="Check for updates on startup"
                              Margin="0,10,0,0" ToolTip="Checks silently when the app opens"
                              Checked="UpdateOnStartup_Changed" Unchecked="UpdateOnStartup_Changed"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CheckUpdatesButton" Content="Check for updates"
                                Style="{StaticResource OutlineButton}" Height="32" Padding="14,0"
                                AutomationProperties.Name="Check for updates" Click="CheckUpdates_Click"/>
                        <Button Grid.Column="2" x:Name="SkipUpdateButton" Content="Skip this version"
                                Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                                AutomationProperties.Name="Skip this update"
                                Visibility="Collapsed" Click="SkipUpdate_Click"/>
                    </Grid>
                    <TextBlock x:Name="UpdateStatusText" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               AutomationProperties.AutomationId="UpdateStatusText"/>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,10"/>
                    <TextBlock Text="Changes apply instantly and are saved for next launch." FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== Toast Host ==================== -->
        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,58,18,0" Width="Auto" IsHitTestVisible="False"/>
    </Grid>
</Window>
