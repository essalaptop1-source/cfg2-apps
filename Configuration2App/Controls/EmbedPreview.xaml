<UserControl x:Class="Configuration2App.Controls.EmbedPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Renders an embed the way Discord displays it: dark card, colored accent bar. -->
    <Border x:Name="Card" Background="#2B2D31" BorderBrush="#1E1F22" BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="AccentBar" Background="#5865F2"/>

            <StackPanel Grid.Column="1" Margin="14,12,14,12">

                <StackPanel x:Name="AuthorRow" Orientation="Horizontal" Visibility="Collapsed">
                    <Border x:Name="AuthorIconCircle" Width="18" Height="18" CornerRadius="9"
                            Background="#3F3F46" Visibility="Collapsed" ClipToBounds="True">
                        <Image x:Name="AuthorIconImage" Width="18" Height="18" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock x:Name="AuthorNameText" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="#DBDEE1" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#00A8FC"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>

                <TextBlock x:Name="DescText" FontSize="13" Foreground="#DBDEE1" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,6,0,0"/>

                <Grid x:Name="FieldsGrid" Visibility="Collapsed" Margin="0,10,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <Image x:Name="ImagePreview" Visibility="Collapsed" MaxHeight="280" MaxWidth="480"
                       Stretch="Uniform" Margin="0,10,0,0" HorizontalAlignment="Left"/>

                <StackPanel x:Name="FooterRow" Orientation="Horizontal" Visibility="Collapsed"
                            Margin="0,10,0,0">
                    <Image x:Name="FooterIconImage" Width="16" Height="16" Stretch="Uniform"
                           Visibility="Collapsed"/>
                    <TextBlock x:Name="FooterText" FontSize="11.5" Foreground="#949BA4"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
