<Window x:Class="Configuration2App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set workspace folder"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border CornerRadius="16" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1" Padding="24">
        <StackPanel>

            <StackPanel Orientation="Horizontal" Cursor="SizeAll"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border Width="44" Height="44" CornerRadius="12"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource IconCommand}"
                              Width="22" Height="22" Stroke="{DynamicResource AccentBrush}"/>
                        <Image x:Name="SetupLogo" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Welcome to Configuration 2" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Choose your executor's workspace folder" FontSize="11.5"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Every .json file in this folder and its subfolders becomes a config, and the subfolder name becomes its category. You can change the folder later in Settings."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,18,0,0"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Style="{StaticResource FieldTextBox}" Height="36"
                         FontSize="11.5" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"/>
                <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="Browse..."
                        Margin="8,0,0,0" Padding="14,8" Click="Browse_Click"/>
            </Grid>

            <Button x:Name="ContinueButton" Style="{StaticResource ModernButton}" Content="Continue"
                    IsEnabled="False" Height="38" Margin="0,18,0,0"
                    HorizontalAlignment="Stretch" Click="Continue_Click"/>

        </StackPanel>
    </Border>
</Window>
