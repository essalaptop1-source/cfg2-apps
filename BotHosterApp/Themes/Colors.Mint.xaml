<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Mint Theme (full black surfaces, green/teal identity) ============ -->
    <Color x:Key="ColorBg">#081009</Color>
    <Color x:Key="ColorBgElevated">#0E1610</Color>
    <Color x:Key="ColorSurface">#17221A</Color>
    <Color x:Key="ColorSurfaceAlt">#223128</Color>
    <Color x:Key="ColorSurfaceHover">#223128</Color>
    <Color x:Key="ColorSurfaceActive">#2B3D31</Color>
    <Color x:Key="ColorCard">#0C140E</Color>
    <Color x:Key="ColorBorder">#203026</Color>
    <Color x:Key="ColorBorderStrong">#34493C</Color>
    <Color x:Key="ColorDivider">#0F1A12</Color>
    <Color x:Key="ColorPanelDivider">#122016</Color>
    <Color x:Key="ColorSidebarActive">#0D1610</Color>
    <Color x:Key="ColorText">#FFFFFF</Color>
    <Color x:Key="ColorTextSecondary">#A0B8A8</Color>
    <Color x:Key="ColorTextTertiary">#6F8A78</Color>
    <Color x:Key="ColorTextDisabled">#56705F</Color>
    <Color x:Key="ColorAccent">#10B981</Color>
    <Color x:Key="ColorAccentHover">#34D399</Color>
    <Color x:Key="ColorAccentPressed">#059669</Color>
    <Color x:Key="ColorOnAccent">#032417</Color>
    <Color x:Key="ColorOnAccentSoft">#1A000000</Color>
    <Color x:Key="ColorAccentSoft">#2610B981</Color>
    <Color x:Key="ColorAccentBorder">#5510B981</Color>
    <Color x:Key="ColorAccentText">#A7F3D0</Color>
    <Color x:Key="ColorGhostOverlay">#05FFFFFF</Color>
    <Color x:Key="ColorScrim">#99000000</Color>

    <!-- Glow colors for DropShadowEffect accents (per-theme) -->
    <Color x:Key="ColorGlow">#8A10B981</Color>
    <Color x:Key="ColorGlowStrong">#A610B981</Color>
    <Color x:Key="ColorGlowDim">#6610B981</Color>

    <!-- ============ Feedback ============ -->
    <Color x:Key="ColorDanger">#E81123</Color>
    <Color x:Key="ColorDangerPressed">#B90F1D</Color>
    <Color x:Key="ColorOnline">#57F287</Color>
    <Color x:Key="ColorWarn">#FEBB3D</Color>

    <!-- ============ Brushes ============ -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource ColorBg}"/>
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource ColorBgElevated}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource ColorSurfaceAlt}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}"/>
    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource ColorSurfaceActive}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColorCard}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource ColorBorderStrong}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource ColorDivider}"/>
    <SolidColorBrush x:Key="PanelDividerBrush" Color="{StaticResource ColorPanelDivider}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource ColorSidebarActive}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource ColorTextTertiary}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource ColorTextDisabled}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource ColorAccentPressed}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource ColorOnAccent}"/>
    <SolidColorBrush x:Key="OnAccentSoftBrush" Color="{StaticResource ColorOnAccentSoft}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource ColorAccentSoft}"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource ColorAccentBorder}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource ColorAccentText}"/>
    <SolidColorBrush x:Key="GhostOverlayBrush" Color="{StaticResource ColorGhostOverlay}"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ColorScrim}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource ColorDangerPressed}"/>
    <SolidColorBrush x:Key="OnlineBrush" Color="{StaticResource ColorOnline}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource ColorWarn}"/>

    <SolidColorBrush x:Key="WindowEdgeBrush" Color="{StaticResource ColorBorderStrong}"/>

    <!-- Window background: dark mint-black depth -->
    <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E1A12" Offset="0"/>
        <GradientStop Color="#0A120C" Offset="0.55"/>
        <GradientStop Color="#050906" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarBgBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0B140D" Offset="0"/>
        <GradientStop Color="#070D08" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============ Gradients (mint identity) ============ -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#14B8A6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0"/>
        <GradientStop Color="#2DD4BF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientPressedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#059669" Offset="0"/>
        <GradientStop Color="#0D9488" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glowing top accent strip: mint -> teal -> cyan -->
    <LinearGradientBrush x:Key="AccentStripBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#14B8A6" Offset="0.55"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
